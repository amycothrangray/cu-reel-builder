# Configure in the Netlify UI under Site settings → Environment variables.
# Vars below are server-side only (Netlify Functions) unless noted otherwise.

# Optional. Enables Claude vision analysis (smarter photo triage, crop planning,
# storytelling order). The app works fully without it using local heuristics.
ANTHROPIC_API_KEY=

# Optional override for the vision model used by netlify/functions/analyze-photos.
# Defaults to the strongest generally available vision model.
VISION_MODEL=

# Client-side (Vite bakes this into the browser bundle — that's expected).
# Optional. Public Dropbox App key (NOT a secret — Dropbox's own docs embed
# this in client-side <script> tags) that enables "Import from Dropbox" on
# the upload screens. Get one free at https://www.dropbox.com/developers/apps
# — create an app with "Scoped access" / "App folder or Full Dropbox" access
# and the Chooser/embed feature, then copy its App key here. Configure in
# Netlify under Site settings → Environment variables. Without it, the
# Dropbox button simply doesn't appear — no other setup is required.
VITE_DROPBOX_APP_KEY=
